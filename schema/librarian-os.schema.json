{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://japonics.io/librarian-os/schema/librarian-os.schema.json",
  "title": "Librarian OS project configuration",
  "description": "The librarian-os.json file at the root of a repository that Librarian OS can open. See INSTRUCTIONS.md.",
  "type": "object",
  "required": [
    "version",
    "project",
    "entryPoints"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
        },
        "homepage": {
          "type": "string",
          "pattern": "^https?://"
        }
      }
    },
    "entryPoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ignore": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "toc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "check": {
          "type": "boolean"
        },
        "descriptions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requireSidecars": {
          "type": "boolean"
        },
        "noLongDashes": {
          "type": "boolean"
        }
      }
    }
  }
}
