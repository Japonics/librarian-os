{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alexandrian-library.local/schema/note.schema.json",
  "title": "Library note sidecar",
  "description": "Metadata that sits next to a Markdown file as <file>.md.json. See INSTRUCTIONS.md.",
  "type": "object",
  "required": [
    "node"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "note",
            "index"
          ]
        },
        "status": {
          "enum": [
            "draft",
            "reviewed"
          ],
          "default": "draft"
        },
        "level": {
          "enum": [
            "intro",
            "intermediate",
            "advanced"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "description": "Position among siblings in the tree. Files without it come last, sorted by path."
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tag"
          },
          "uniqueItems": true
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "to",
          "rel"
        ],
        "additionalProperties": false,
        "properties": {
          "to": {
            "$ref": "#/$defs/id"
          },
          "rel": {
            "enum": [
              "prerequisite",
              "extends",
              "related",
              "contrasts",
              "example-of",
              "applies",
              "part-of"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "type",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "$ref": "#/$defs/tag"
          },
          "type": {
            "enum": [
              "paper",
              "book",
              "report",
              "standard",
              "documentation",
              "website",
              "course",
              "other"
            ]
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "year": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 2200
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "verified": {
            "type": "boolean"
          },
          "checked": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}$"
          }
        }
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "term"
        ],
        "additionalProperties": false,
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "anchor": {
            "type": "string",
            "pattern": "^#[^\\s]+$"
          },
          "definition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "q",
          "a"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/tag"
          },
          "type": {
            "enum": [
              "recall",
              "explain",
              "apply",
              "compare"
            ]
          },
          "q": {
            "type": "string",
            "minLength": 1
          },
          "a": {
            "type": "string",
            "minLength": 1
          },
          "hint": {
            "type": "string",
            "minLength": 1
          },
          "anchor": {
            "type": "string",
            "pattern": "^#[^\\s]+$"
          },
          "origin": {
            "enum": [
              "author",
              "ai"
            ],
            "default": "author"
          },
          "reviewed": {
            "type": "boolean"
          }
        }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "group": {
          "$ref": "#/$defs/tag"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)*$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    }
  }
}
