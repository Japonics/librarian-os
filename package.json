{
  "name": "librarian-os",
  "private": true,
  "version": "0.2.0",
  "description": "Reader and tools for Markdown knowledge repositories",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/server/main.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/main.ts",
    "check": "tsx src/cli/main.ts check",
    "scaffold": "tsx src/cli/main.ts scaffold",
    "toc": "tsx src/cli/main.ts toc",
    "index": "tsx src/cli/main.ts index",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^26.6.5",
    "sass": "^1.106.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^2.31.0",
    "ajv": "^8.20.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.2.0",
    "minisearch": "^7.2.0",
    "openai": "^7.45.1"
  },
  "license": "MIT",
  "homepage": "https://japonics.io"
}
